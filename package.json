{
  "name": "web-mount",
  "version": "1.5.5",
  "engines": {
    "node": ">=16.14"
  },
  "description": "把本机各端口的服务反向代理挂载到 Yunzai HTTP 端口的子路径下，支持按路径/来源/方法智能分发与 WebSocket，自带锅巴面板页面",
  "type": "module",
  "main": "index.js",
  "author": "wangdefa1001",
  "license": "MIT",
  "homepage": "https://github.com/wangdefa1001/web-mount",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdefa1001/web-mount.git"
  },
  "keywords": [
    "yunzai",
    "guoba",
    "reverse-proxy",
    "web-mount"
  ],
  "files": [
    "index.js",
    "guoba.support.js",
    "guoba",
    "lib",
    "config",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run-all.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"index.js\" \"lib/**/*.js\" \"guoba.support.js\" \"guoba/index.js\" \"test/**/*.mjs\" \"eslint.config.js\"",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.10"
  }
}
